            "pages": [
              "overview"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "riskflow",
              "performance",
              "market-intelligence",
              "research-and-records"
            ]
          },
          {
            "group": "Desk 2.0",
            "pages": [
              "desk-2/overview",
              "desk-2/suite",
              "desk-2/collaboration",
              "desk-2/delivery-status"
            ]
          },
          {
            "group": "AI Features",
            "pages": [
              "narrativeflow",
              "cao-and-agents",
              "decision-workspaces",
              "team-and-collaboration"
            ]
          },
          {
            "group": "Trading Tools",
            "pages": [
              "trading-and-decisions",
              "psychassist"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "accounts-and-settings",
              "platform-and-support"
            ]
          }
        ]
      }
    ]
  },
  "icons": {
    "library": "lucide"
  },
