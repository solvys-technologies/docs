    "light": "/images/Fintheon-logo-gray-tight.png",
    "dark": "/images/Fintheon-logo-black-tight.png"
  },
  "colors": {
    "primary": "#000000",
    "light": "#444444",
    "dark": "#352d21"
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "primary": {
      "type": "github",
